# Lu par le CLI Prisma : migrate, db seed, studio.
# Copier en .env et renseigner la base LOCALE.
#
# Ce fichier reste volontairement sur localhost, meme quand .env.local pointe
# sur la base de production : une commande Prisma lancee par inadvertance ne
# peut alors pas atteindre la base en ligne.

DATABASE_URL="postgresql://hotel_user:mot_de_passe@localhost:5432/hotel_booking_db?schema=public"
