# Lu par Next.js. Copier en .env.local et renseigner les sept valeurs.
# .env.local est ignore par git : aucune de ces valeurs n'est versionnee.

# Base de donnees. Chaine locale en developpement ; en production, la chaine
# Neon en -pooler, reservee a l'application.
DATABASE_URL="postgresql://hotel_user:mot_de_passe@localhost:5432/hotel_booking_db?schema=public"

# Adresse publique de l'application. Sert a metadataBase, aux liens des
# courriels transactionnels et aux liens de reinitialisation de mot de passe.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Signature des jetons de session, chaine longue et aleatoire, distincte entre
# developpement et production. Facultative en developpement, ou une cle de repli
# prend le relais ; obligatoire en production, ou son absence arrete le demarrage.
JWT_SECRET=

# Stripe en mode test. La cle publiable est envoyee au navigateur : sur Vercel
# elle doit etre declaree en variable simple, jamais en Secret, sinon elle
# arrive tronquee a la compilation.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_

# Envoi des courriels via SMTP Gmail. GMAIL_APP_PASSWORD est un mot de passe
# d'application genere dans le compte Google, pas le mot de passe du compte.
GMAIL_USER=
GMAIL_APP_PASSWORD=
